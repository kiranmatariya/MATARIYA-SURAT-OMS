# Copy this file to .env.local and replace the values for your PostgreSQL server.
# App runtime / pooler connection (Supabase Transaction pooler uses port 6543).
DATABASE_URL="postgresql://matariya_surat_user:change-me@localhost:5432/matariya_surat_oms?schema=public"

# Migrations prefer this URL. On Supabase use Session pooler or Direct on port 5432.
# If unset, migrations fall back to DATABASE_URL.
DIRECT_URL="postgresql://matariya_surat_user:change-me@localhost:5432/matariya_surat_oms?schema=public"

# Use "postgres" after the database migration has been applied. With no database
# configured, omit this value and the existing browser-local development data remains usable.
NEXT_PUBLIC_DATA_PROVIDER="postgres"

# Generate with: npx @better-auth/cli secret
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3100"

# Optional one-time first admin. Set on Vercel for the first production deploy,
# then remove these four values so the password is not kept in env forever.
FIRST_ADMIN_NAME="Your Name"
FIRST_ADMIN_EMAIL="owner@example.com"
FIRST_ADMIN_USERNAME="owner"
FIRST_ADMIN_PASSWORD="replace-with-a-strong-temporary-password"
